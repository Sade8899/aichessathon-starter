.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
submission.zip
*.pgn

# Narrow exception to the *.pgn rule above: rated-game PGNs preserved as
# submission evidence under a submission folder's games/ directory are the
# record of what the uploaded engine actually played, so they are tracked.
!submission*/games/*.pgn

# Third-party engine binaries used only as local benchmark opponents. They are
# never shipped, never imported by agent.py, and several are GPL/AGPL, so the
# binaries stay untracked; tests/external_engines.json records their provenance.
tests/external_engines/

# NNUE experiment intermediates. Generated games, labelled positions and training
# datasets are large, reproducible from the manifests, and must never reach a
# submission. The manifests, metrics and reports under tests/results/nnue/ are tracked.
tests/results/nnue/games/
tests/results/nnue/labels/
tests/results/nnue/dataset/

# The trained weight file sits at the repo root only so the candidate can load it
# during measurement. The candidate was rejected, so nothing ships; the weights are
# preserved under tests/results/nnue/model_*/quantized.npz with their hashes recorded.
nnue_weights.npz

# V2 sibling groups and encoded tensors: large, reproducible from parents.jsonl and the
# manifests, and must never reach a submission. Reports under tests/results/nnue/v2/ are
# tracked; the group shards, the parent plan and the encoded cache are not.
tests/results/nnue/groups/
tests/results/nnue/v2/encoded.npz
nnue_v2_weights.npz
