# Platform reproduction for the NNUE gates.
#
# This image contains the competition stack and nothing else. No Stockfish, no benchmark
# engines, no training data, no repository. A candidate is validated by mounting only
# the contents of its zip, read-only, into a container with one CPU and 2 GB.
#
# The host .venv carries the same package versions but on Python 3.14, which is not the
# platform interpreter, so no final performance number is taken from it.

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp \
    NUMBA_CACHE_DIR=/tmp \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    TORCH_NUM_THREADS=1

# Pinned to the versions the platform documents. --no-cache-dir keeps the image lean and
# leaves nothing that a later run could silently pick up.
RUN pip install --no-cache-dir \
        "numpy==2.5.2" \
        "chess==1.11.2" \
        "numba==0.67.0" \
        "onnxruntime==1.29.0" \
    && pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu "torch==2.13.0" \
    || pip install --no-cache-dir "torch==2.13.0"

WORKDIR /agent
CMD ["python", "-c", "import agent; print('imported')"]
