FROM python:3.12-slim AS python-test
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends make && rm -rf /var/lib/apt/lists/*
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_CACHE_DIR=/tmp/uv-cache UV_NO_SYNC=1 \
    PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/workspace \
    HOME=/tmp XDG_CACHE_HOME=/tmp RUFF_CACHE_DIR=/tmp/ruff MYPY_CACHE_DIR=/tmp/mypy \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache
COPY . .
CMD ["make", "gate"]

FROM python-test AS tournament
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY tests/tournament/build_engines.py tests/tournament/engines.lock.json /opt/development/
RUN python /opt/development/build_engines.py
ENV PATH=/opt/chessathon/bin:$PATH
